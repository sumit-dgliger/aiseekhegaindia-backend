# Copy to .env and fill in real values. Never commit .env.

NODE_ENV=development
PORT=4000

# Neon (dev branch) — pooled for runtime, direct for migrations
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require
DIRECT_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require

# Session JWT (≥ 32 random bytes / chars)
SESSION_SECRET=replace-with-at-least-32-random-characters

# Google OAuth (Web application client)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_PROJECT_ID=
GOOGLE_REDIRECT_URI=http://localhost:4000/api/v1/auth/google/callback

# Front + CORS
FRONTEND_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:3000,https://aiseekhegaindia.com

# Optional: override derived default (false in development, true in production)
# COOKIE_SECURE=false
SESSION_TTL_DAYS=7

# Optional Google endpoint overrides
# GOOGLE_AUTH_URI=https://accounts.google.com/o/oauth2/auth
# GOOGLE_TOKEN_URI=https://oauth2.googleapis.com/token
# GOOGLE_AUTH_PROVIDER_CERT_URL=https://www.googleapis.com/oauth2/v1/certs
